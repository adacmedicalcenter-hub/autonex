{
  "name": "autonex-backend",
  "version": "1.0.0",
  "description": "AutoNex Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/run-migrations.js",
    "migrate:status": "node scripts/migration-status.js",
    "test": "node --test test/*.test.js",
    "admin:provision": "node scripts/provision-admin.js",
    "pilot": "node scripts/pilot-server.js",
    "pilot:admin": "node scripts/pilot-server.js --admin-phone"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.22.3",
    "firebase-admin": "13.6.0",
    "helmet": "7.1.0",
    "joi": "17.11.0",
    "jsonwebtoken": "9.0.2",
    "pg": "^8.11.3",
    "socket.io": "4.7.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
